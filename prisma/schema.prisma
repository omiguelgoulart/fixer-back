// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Planta {
  id          Int    @id @default(autoincrement())
  nome        String
  localizacao String
  codigo      String @unique
  area        Area[]

  @@map("plantas")
}

model Area {
  id        Int       @id @default(autoincrement())
  nome      String
  id_planta Int
  codigo    String    @unique
  planta    Planta    @relation(fields: [id_planta], references: [id], onDelete: Cascade)
  sistema   Sistema[]

  @@map("areas")
}

model Sistema {
  id      Int     @id @default(autoincrement())
  nome    String
  id_area Int
  codigo  String  @unique
  area    Area    @relation(fields: [id_area], references: [id], onDelete: Cascade)
  ativo   Ativo[]

  @@map("sistemas")
}

model Ativo {
  id                  Int           @id @default(autoincrement())
  nome                String
  fabricante          String
  modelo              String
  data_aquisicao      DateTime?
  localizacao_interna String?
  tipo_ativo          TipoAtivo
  situacao            SituacaoAtivo @default(ATIVO)
  criticidade         Criticidade
  id_sistema          Int
  codigo              String        @unique
  sistema             Sistema       @relation(fields: [id_sistema], references: [id], onDelete: Cascade)
  fotos               Foto[]        // 👈 relação 1:N
  subativos           Subativo[]
  manutencoes         Manutencao[]
  falhas              Falha[]

  @@map("ativos")
}

model Foto {
  id        Int    @id @default(autoincrement())
  url       String
  descricao String
  ativo     Ativo  @relation(fields: [ativoId], references: [id])
  ativoId   Int

  @@map("fotos")
}

enum TipoAtivo {
  MECANICO
  ELETRICO
  ELETRONICO
  HIDRAULICO
  OUTRO
}

enum SituacaoAtivo {
  ATIVO
  INATIVO
  MANUTENCAO
  DESCARTADO
}

enum Criticidade {
  ALTA
  MEDIA
  BAIXA
}

model Falha {
  id              Int         @id @default(autoincrement())
  descricao       String
  data_ocorrencia DateTime
  criticidade     Criticidade
  id_ativo        Int
  ativo           Ativo       @relation(fields: [id_ativo], references: [id], onDelete: Cascade)

  @@map("falhas")
}

model Subativo {
  id       Int    @id @default(autoincrement())
  nome     String
  tipo     String
  codigo              String        @unique
  id_ativo Int
  ativo    Ativo  @relation(fields: [id_ativo], references: [id], onDelete: Cascade)

  @@map("subativos")
}

model Manutencao {
  id          Int            @id @default(autoincrement())
  tipo        TipoManutencao
  data_inicio DateTime
  data_fim    DateTime
  descricao   String
  id_ativo    Int
  ativo       Ativo          @relation(fields: [id_ativo], references: [id], onDelete: Cascade)

  @@map("manutencoes")
}

enum TipoManutencao {
  CORRETIVA
  PREVENTIVA
  PREDITIVA
}

model Usuario {
  id        Int     @id @default(autoincrement())
  nome      String
  email     String  @unique
  senha     String
  ativo     Boolean @default(true)
  tipo      TipoUsuario

  @@map("usuarios")
}

enum TipoUsuario {
  GESTOR
  GERENTE
  TECNICO
}