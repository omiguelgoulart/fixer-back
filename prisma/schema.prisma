// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Planta {
  id          Int    @id @default(autoincrement())
  nome        String
  localizacao String
  codigo      String @unique
  area        Area[]

  @@map("plantas")
}

model Area {
  id        Int       @id @default(autoincrement())
  nome      String
  id_planta Int
  codigo    String    @unique
  planta    Planta    @relation(fields: [id_planta], references: [id], onDelete: Cascade)
  sistema   Sistema[]

  @@map("areas")
}

model Sistema {
  id      Int     @id @default(autoincrement())
  nome    String
  id_area Int
  codigo  String  @unique
  area    Area    @relation(fields: [id_area], references: [id], onDelete: Cascade)
  ativo   Ativo[]

  @@map("sistemas")
}

model Ativo {
  id                  Int           @id @default(autoincrement())
  nome                String
  fabricante          String
  modelo              String
  data_aquisicao      DateTime?
  localizacao_interna String?
  tipo_ativo          TipoAtivo
  situacao            SituacaoAtivo @default(ATIVO)
  criticidade         Criticidade
  id_sistema          Int
  codigo              String        @unique
  sistema             Sistema       @relation(fields: [id_sistema], references: [id], onDelete: Cascade)
  foto                String?        // 👈 relação 1:N
  fotos               Foto[]        // 👈 relação 1:N
  subativos           Subativo[]
  manutencoes         Manutencao[]
  ordensServico      OrdemServico[]

  @@map("ativos")
}

model Foto {
  id        Int    @id @default(autoincrement())
  url       String
  descricao String
  ativo     Ativo  @relation(fields: [ativoId], references: [id])
  ativoId   Int

  @@map("fotos")
}

enum TipoAtivo {
  MECANICO
  ELETRICO
  ELETRONICO
  HIDRAULICO
  OUTRO
}

enum SituacaoAtivo {
  ATIVO
  INATIVO
  MANUTENCAO
  DESCARTADO
}

enum Criticidade {
  ALTA
  MEDIA
  BAIXA
}


model Subativo {
  id       Int    @id @default(autoincrement())
  nome     String
  tipo     String
  codigo              String        @unique
  id_ativo Int
  ativo    Ativo  @relation(fields: [id_ativo], references: [id], onDelete: Cascade)

  @@map("subativos")
}

// Enum para tipos de manutenção
enum TipoManutencao {
  CORRETIVA
  PREVENTIVA
  PREDITIVA
}

// Enum para tipos de usuário
model Usuario {
  id                  Int             @id @default(autoincrement())
  nome                String
  email               String          @unique
  senha               String
  ativo               Boolean         @default(true)
  tipo                TipoUsuario
  ordensResponsavel   OrdemServico[]  @relation("ResponsavelNaOrdemServico")
  ordensServico       OrdemServico[]  @relation("UsuarioNaOrdemServico")
  manutencoesUsuario  Manutencao[]    @relation("UsuarioNaManutencaoDireta")

  @@map("usuarios")
}


model OrdemServico {
  id                  Int             @id @default(autoincrement())
  titulo              String
  status              StatusOrdem
  prioridade          PrioridadeOrdem
  responsavelId       Int
  responsavel         Usuario         @relation("ResponsavelNaOrdemServico", fields: [responsavelId], references: [id])
  ativoId             Int
  ativo               Ativo           @relation(fields: [ativoId], references: [id])
  dataInicioPlanejada DateTime        @default(now())
  dataVencimento      DateTime
  tipoManutencao      TipoManutencao
  usuarioId           Int
  usuario             Usuario         @relation("UsuarioNaOrdemServico", fields: [usuarioId], references: [id])
  tarefas             Tarefa[]
  insumos             Insumo[]
  manutencao          Manutencao?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@map("ordens_servico")
}

model Manutencao {
  id              Int            @id @default(autoincrement())
  tipo            TipoManutencao
  data_inicio     DateTime
  data_fim        DateTime
  descricao       String
  id_ativo        Int
  ativo           Ativo          @relation(fields: [id_ativo], references: [id], onDelete: Cascade)
  ordemServicoId  Int            @unique
  ordemServico    OrdemServico   @relation(fields: [ordemServicoId], references: [id])
  usuarioId       Int
  usuario         Usuario        @relation("UsuarioNaManutencaoDireta", fields: [usuarioId], references: [id])

  @@map("manutencoes")
}

model Tarefa {
  id              Int           @id @default(autoincrement())
  descricao       String
  concluida       Boolean       @default(false)
  ordemServicoId  Int
  ordemServico    OrdemServico  @relation(fields: [ordemServicoId], references: [id])

  @@map("tarefas")
}

model Insumo {
  id              Int           @id @default(autoincrement())
  nome            String
  codigo          String
  quantidade      Int
  ordemServicoId  Int
  ordemServico    OrdemServico  @relation(fields: [ordemServicoId], references: [id])

  @@map("insumos")
}

enum StatusOrdem {
  EM_ABERTO
  EM_ANDAMENTO
  CONCLUIDA
}

enum PrioridadeOrdem {
  ALTA
  MEDIA
  BAIXA
}

enum TipoUsuario {
  GESTOR
  GERENTE
  TECNICO
}
